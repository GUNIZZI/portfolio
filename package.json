{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "pnpm plan-publish && next dev",
        "build": "pnpm plan-publish && next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "tc": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "check": "pnpm tc && pnpm lint && pnpm format:check && pnpm test",
        "prepare": "husky",
        "plan-index": "node scripts/build-plan-index.mjs",
        "plan-publish": "node scripts/publish-plan-viewer.mjs"
    },
    "dependencies": {
        "@google-analytics/data": "^7.3.0",
        "@gsap/react": "^2.1.2",
        "@hookform/resolvers": "^7.0.7",
        "@next/third-parties": "16.4.6",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/extension-image": "^3.34.0",
        "@tiptap/extension-table": "^3.34.0",
        "@tiptap/pm": "^3.34.0",
        "@tiptap/react": "^3.34.0",
        "@tiptap/starter-kit": "^3.34.0",
        "@vercel/blob": "^2.9.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase-admin": "^14.5.1",
        "framer-motion": "^14.12.0",
        "google-auth-library": "11.3.4",
        "gsap": "^3.15.1",
        "lucide-react": "^1.74.0",
        "next": "16.4.6",
        "next-themes": "0.4.6",
        "radix-ui": "^1.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.92.0",
        "sanitize-html": "^2.18.2",
        "server-only": "^0.0.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/turbopack": "4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^22.20.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/sanitize-html": "^2.16.2",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-boundaries": "^7.4.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "^5",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@10.25.0",
    "engines": {
        "node": ">=22"
    },
    "lint-staged": {
        "*.{ts,tsx,mjs,js}": [
            "eslint --fix --max-warnings=0 --no-warn-ignored",
            "prettier --write"
        ],
        "*.{css,md,mdx,json,yml,yaml}": [
            "prettier --write"
        ]
    },
    "type": "module"
}
